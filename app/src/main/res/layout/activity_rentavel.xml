<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".RentavelActivity">

    <TextView
        android:id="@+id/tvCombustivel1"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:text="Consumo Combustivel 1"
        android:textSize="18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.10" />

    <TextView
        android:id="@+id/tvCombustivel2"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:text="Consumo Combustivel 2"
        android:textSize="18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/tvCombustivel1"
        app:layout_constraintStart_toStartOf="@+id/tvCombustivel1"
        app:layout_constraintTop_toBottomOf="@+id/tvCombustivel1"
        app:layout_constraintVertical_bias="0.0" />

    <TextView
        android:id="@+id/tvPreco1"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:text="Preço Combustivel 1"
        android:textSize="18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/tvCombustivel2"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@id/tvCombustivel2"
        app:layout_constraintTop_toBottomOf="@id/tvCombustivel2"
        app:layout_constraintVertical_bias="0.0" />

    <TextView
        android:id="@+id/tvPreco2"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:text="Preço Combustivel 2"
        android:textSize="18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/tvPreco"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/tvPreco1"
        app:layout_constraintTop_toBottomOf="@+id/tvPreco1"
        app:layout_constraintVertical_bias="0.0" />

    <EditText
        android:id="@+id/etConsumoCombustivel1"
        android:layout_width="100dp"
        android:layout_height="50dp"
        android:ems="10"
        android:inputType="numberDecimal"
        app:layout_constraintBottom_toBottomOf="@+id/tvCombustivel1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toEndOf="@id/tvCombustivel1"
        app:layout_constraintTop_toTopOf="@+id/tvCombustivel1" />

    <EditText
        android:id="@+id/etConsumoCombustivel2"
        android:layout_width="100dp"
        android:layout_height="50dp"
        android:ems="10"
        android:inputType="numberDecimal"
        app:layout_constraintBottom_toBottomOf="@+id/tvCombustivel2"
        app:layout_constraintEnd_toEndOf="@+id/etConsumoCombustivel1"
        app:layout_constraintStart_toEndOf="@+id/tvCombustivel2"
        app:layout_constraintTop_toTopOf="@+id/tvCombustivel2" />

    <EditText
        android:id="@+id/etPrecoComb1"
        android:layout_width="100dp"
        android:layout_height="50dp"
        android:ems="10"
        android:inputType="numberDecimal"
        app:layout_constraintBottom_toBottomOf="@+id/tvPreco1"
        app:layout_constraintEnd_toEndOf="@+id/etConsumoCombustivel2"
        app:layout_constraintStart_toEndOf="@+id/tvCombustivel2"
        app:layout_constraintTop_toTopOf="@+id/tvPreco1" />

    <EditText
        android:id="@+id/etPrecoComb2"
        android:layout_width="100dp"
        android:layout_height="50dp"
        android:ems="10"
        android:inputType="numberDecimal"
        app:layout_constraintBottom_toBottomOf="@+id/tvPreco2"
        app:layout_constraintEnd_toEndOf="@+id/etPrecoComb1"
        app:layout_constraintStart_toEndOf="@+id/tvPreco2"
        app:layout_constraintTop_toTopOf="@+id/tvPreco2" />

    <Button
        android:id="@+id/btCalculate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Calcular"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvPreco2"
        app:layout_constraintVertical_bias="0.0" />

    <Button
        android:id="@+id/btSearch"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:layout_marginEnd="10dp"
        android:text="Buscar"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="@+id/etConsumoCombustivel1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/etConsumoCombustivel1"
        app:layout_constraintTop_toTopOf="@+id/etConsumoCombustivel1" />

    <Button
        android:id="@+id/btSearch2"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:layout_marginEnd="10dp"
        android:text="Buscar"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="@+id/etConsumoCombustivel2"
        app:layout_constraintEnd_toEndOf="@+id/btSearch"
        app:layout_constraintStart_toStartOf="@+id/btSearch"
        app:layout_constraintTop_toTopOf="@+id/etConsumoCombustivel2" />

    <TextView
        android:id="@+id/tvResut"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:textSize="25dp"
        android:text="O combustivel mais barato é:"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btCalculate"
        app:layout_constraintVertical_bias="0.0" />

    <EditText
        android:id="@+id/etResult"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:ems="10"
        android:inputType="text"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvResut"
        app:layout_constraintVertical_bias="0.0" />

</androidx.constraintlayout.widget.ConstraintLayout>